# nado configuration
EXCHANGE_TYPE=nado

# Nado account (required)
# Nado uses private key for EIP712 signing (no API key required)
# 两种用法：
# 1）直接使用主钱包私钥（简单但安全性略差）：
#    - 留空 NADO_OWNER_ADDRESS
#    - NADO_PRIVATE_KEY=主钱包私钥
# 2）使用 linked signer / 1-Click Trading 生成的 1CT 私钥（推荐）：
#    - NADO_OWNER_ADDRESS=主钱包地址（绑定子账号的 owner）
#    - NADO_PRIVATE_KEY=linked signer / 1CT 私钥（仅用于签名）
NADO_OWNER_ADDRESS=''
NADO_PRIVATE_KEY=''
NADO_ENV='mainnet'   # 'mainnet' or 'testnet'
NADO_SUBACCOUNT_NAME='default'

# Nado 下单保证金模式：某些合约为 isolated-only（会报 error_code=2122）
# true: 下单 appendix 写入 isolated 位；false: 不写入
NADO_ISOLATED=false
# 注意：
# 1) appendix 中与保证金相关的参数会被“固化到链上订单里”，已挂/已提交的订单无法修改。
#    如果你改了这里的配置，只会影响“后续新下的订单”，不会回写到已存在的订单。
# 2) NADO_ISOLATED_MARGIN_USDC 仅用于“isolated 保证金池尚未建立（程序判定 _iso_margin_seeded=false）”时的建仓阶段。
#    一旦 isolated 池已建立（探测到已存在 isolated 持仓，或首笔建仓成交后），程序会切换为“补单保证金策略”：
#    后续每个非 reduce_only 的开仓/补单都会把 appendix 高 64 位的 isolated_margin 写成该笔订单的名义价值（约等于 price * amount）。
#    因此你会看到成交事件的 appendix 解码出来的 isolated_margin_usdc 往往接近 price*amount，而不是固定等于本配置的 NADO_ISOLATED_MARGIN_USDC。
#    如果你希望再次“固定使用” NADO_ISOLATED_MARGIN_USDC，通常需要先取消/清空旧订单并确保 _iso_margin_seeded=false，再重新下首笔建仓单。
#
# 可选：isolated 下单时在 appendix 高 64 位携带初始保证金（USDC）
# 例如 1000 = 1000 USDC；0 表示不携带该值（保持旧行为）
NADO_ISOLATED_MARGIN_USDC=0

# isolated 池建立后（_iso_margin_seeded=true）每笔开仓/补单写入的保证金策略
# - notional(默认): 每笔约等于该笔名义价值（price*amount，保持旧行为）
# - fixed: 每笔都固定写入 NADO_ISOLATED_MARGIN_USDC（用于控制整体杠杆）
# - step: 每笔写入 NADO_ISOLATED_MARGIN_STEP_USDC（可用于保守补单，降低额外占用）
NADO_ISOLATED_MARGIN_AFTER_SEED_MODE='notional'
NADO_ISOLATED_MARGIN_STEP_USDC=0

# Trading symbol：与 Nado 产品名称一致，用于解析与日志
# 常见：AAVEUSDT0 / ETH-PERP / BTC-PERP（换币种时与 NADO_PRODUCT_ID 对应）
NADO_SYMBOL='AAVEUSDT0'
# Nado 永续 product_id（建议显式设置，避免解析错误）
# 常见：26=AAVE, 4=ETH, 2=BTC, 8=SOL；可用 scripts/list_nado_products.py 查询完整列表
NADO_PRODUCT_ID='26'

# Optional: override endpoints (usually not needed)
# NADO_GATEWAY_REST='https://gateway.prod.nado.xyz/v1'
# NADO_GATEWAY_WS='wss://gateway.prod.nado.xyz/v1/ws'
# NADO_SUBSCRIPTIONS_WS='wss://gateway.prod.nado.xyz/v1/subscribe'
# NADO_ARCHIVE_URL='https://archive.prod.nado.xyz/v1'
# NADO_TRIGGER_URL='https://trigger.prod.nado.xyz/v1'

# Nado 网络时序与重试（可选，建议保留默认）
# NADO_RECV_TIME_OFFSET_MS: 下单 nonce 的 recv_time 预留毫秒（网络抖动大可调高，例如 1500~2500）
# NADO_CONTRACTS_QUERY_RETRY: 启动时 contracts 查询重试次数
# NADO_CONTRACTS_QUERY_RETRY_DELAY_MS: contracts 查询重试基础间隔毫秒（第N次会乘以N）
NADO_RECV_TIME_OFFSET_MS=1200
NADO_CONTRACTS_QUERY_RETRY=3
NADO_CONTRACTS_QUERY_RETRY_DELAY_MS=400

# Strategy direction and market
DIRECTION='LONG'
# MARKET_ID：策略内部市场编号，与 NADO_PRODUCT_ID 无直接对应；多策略时用于区分（如 0=AAVE, 1=BTC）
MARKET_ID=0
# 风控K线数据源（Binance）交易对。更换币种时同步修改，如 BTCUSDT / SOLUSDT
RISK_BINANCE_SYMBOL='AAVEUSDT'
# 风控K线数据源（Binance）市场：spot(现货) 或 futures(U本位永续)
RISK_BINANCE_MARKET='spot'
# 风控K线每次拉取根数（1m/15m共用，默认100；越大越稳，越小越敏捷）
RISK_KLINE_COUNT=100

# Position and order caps
# MAX_TOTAL_ORDERS: 最大活跃订单数（开平仓合计）
# MAX_POSITION: 最大总持仓（单位=币）
# ALER_POSITION: 仓位预警阈值（达到后策略会更保守）
MAX_TOTAL_ORDERS=10
MAX_POSITION=1.0
ALER_POSITION=0.3

# 网格（刷量优先，允许密集成交）
# GRID_SPREAD: 单格价差百分比（0.05 = 0.05%）
# GRID_COUNT: 每侧网格层数
# GRID_AMOUNT: 每格下单数量（单位=币）
GRID_SPREAD=0.16
GRID_COUNT=3
GRID_AMOUNT=1

# 主风控（放宽到能开单）
# ADVERSE_* 用于15m不利趋势检测：
# LONG: close<ema 且 adx强趋势 且 pdi<mdi 且 rsi低于阈值 -> 暂停开仓
ADVERSE_EMA_PERIOD=20
ADVERSE_RSI_PERIOD=14
ADVERSE_ADX_PERIOD=14
ADVERSE_ADX_THRESHOLD=25
ADVERSE_RSI_LONG_THRESHOLD=49
ADVERSE_RSI_SHORT_THRESHOLD=70

# 均值回归风控（放宽）
# EMA_REVERSION_THRESHOLD: 价格偏离EMA超过阈值时暂停（0.018=1.8%）
EMA_REVERSION_PERIOD=60
EMA_REVERSION_THRESHOLD=0.018

# 价格精度（按交易所/币种设置，下单前会按此舍入）
# PRICE_PRECISION: 最小价格变动单位，如 0.1=ETH、0.01=部分币种（默认 0.1）
PRICE_PRECISION=0.1

# REST 对账（WS 主驱动，REST 仅低频校准）
# REST_SYNC_INTERVAL_SEC: REST 同步间隔秒（默认60）
# DISAPPEARED_ORDER_CONFIRM_SEC: REST 发现订单消失后延迟确认秒（默认3），避免短暂漏单被当成交
REST_SYNC_INTERVAL_SEC=60
DISAPPEARED_ORDER_CONFIRM_SEC=3

# 大间距补单
# OVER_RANGE_GAP_MULTIPLIER: 有卖单时=开平仓间距超过该倍数步长触发；无卖单时=开仓价与当前价间距超过该倍数步长触发追单（默认2.5）
OVER_RANGE_GAP_MULTIPLIER=2.5

# 急变保护（保留）
# ATR_THRESHOLD: 控制动态网格间距放大触发（ATR超过该值时增大间距）
# RAPID_MOVE_THRESHOLD_PCT: 1m 急涨/急跌触发阈值（0.008=0.8%）
# RAPID_MOVE_ATR_PERIOD: 急变检测的 ATR 计算周期
# RAPID_MOVE_SOURCE_MAX_DIFF_PCT: Nado实时价与Binance K线收盘允许最大偏差（超出时回退K线价）
ATR_THRESHOLD=0.8
RAPID_MOVE_THRESHOLD_PCT=0.008
RAPID_MOVE_ATR_PERIOD=7
RAPID_MOVE_SOURCE_MAX_DIFF_PCT=0.2

# Logging
LOG_LEVEL='INFO'
LOG_FORMAT='%(asctime)s - %(filename)s:%(lineno)d - %(levelname)s - %(message)s'
LOG_DIR='./logs'

# Proxy (optional)
# PROXY_URL='http://127.0.0.1:7890'

# DingTalk notify (optional)
DINGTALK_WEBHOOK=''
DINGTALK_KEYWORD='Nado'

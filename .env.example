# lighter configuration
BASE_URL=https://mainnet.zklighter.elliot.ai
L1_ADDRESS=''
ACCOUNT_INDEX='0'
API_KEY_INDEX='0'
API_KEY_PRIVATE_KEY=''

# grvt configuration
GRVT_PRIVATE_KEY = ''
GRVT_API_KEY=''
GRVT_TRADING_ACCOUNT_ID = ''
GRVT_ENV = ''

# nado configuration
# Nado uses private key for EIP712 signing (no API key required)
NADO_PRIVATE_KEY=''  # Your wallet private key (with or without 0x prefix)
NADO_ENV='mainnet'   # 'mainnet' (Ink) or 'testnet' (Ink Sepolia)

# Mainnet Endpoints (Ink chain, chain_id: 57073):
#   Gateway REST: https://gateway.prod.nado.xyz/v1
#   Gateway WS: wss://gateway.prod.nado.xyz/v1/ws
#   Subscriptions: wss://gateway.prod.nado.xyz/v1/subscribe
#   Archive: https://archive.prod.nado.xyz/v1
#   Trigger: https://trigger.prod.nado.xyz/v1
#   Endpoint Contract: 0x05ec92D78ED421f3D3Ada77FFdE167106565974E

# Testnet Endpoints (Ink Sepolia, chain_id: 763373):
#   Gateway REST: https://gateway.test.nado.xyz/v1
#   Gateway WS: wss://gateway.test.nado.xyz/v1/ws
#   Subscriptions: wss://gateway.test.nado.xyz/v1/subscribe
#   Archive: https://archive.test.nado.xyz/v1
#   Trigger: https://trigger.test.nado.xyz/v1
#   Endpoint Contract: 0x698D87105274292B5673367DEC81874Ce3633Ac2

# Optional: Override default endpoints (usually not needed)
# NADO_GATEWAY_REST='https://gateway.prod.nado.xyz/v1'
# NADO_GATEWAY_WS='wss://gateway.prod.nado.xyz/v1/ws'
# NADO_SUBSCRIPTIONS_WS='wss://gateway.prod.nado.xyz/v1/subscribe'
# NADO_ARCHIVE_URL='https://archive.prod.nado.xyz/v1'
# NADO_TRIGGER_URL='https://trigger.prod.nado.xyz/v1'

# Nado Product IDs (use with MARKET_ID mapping):
# 0: USDT0 (quote currency)
# 1: KBTC
# 2: BTC-PERP
# 3: WETH
# 4: ETH-PERP
# 5: USDC
# 8: SOL-PERP
# 10: XRP-PERP
# 14: BNB-PERP
# 16: HYPE-PERP
# 18: ZEC-PERP
# 20: MON-PERP
# 22: FARTCOIN-PERP

# Logging configuration
LOG_LEVEL='INFO'
LOG_FORMAT='%(asctime)s - %(filename)s:%(lineno)d - %(levelname)s - %(message)s'
LOG_FILE_DIR=./logs

# Proxy configuration (optional)
# PROXY_URL='http://127.0.0.1:7890'

# Grid trading configuration for different exchanges
# Common grid trading configuration (used by all exchanges)
DIRECTION='LONG'
GRID_COUNT=3  # 每侧网格数量
GRID_AMOUNT=0.01  # 单网格挂单量
GRID_SPREAD=0.05  # 单网格价差（百分比）
MAX_TOTAL_ORDERS=10  # 最大活跃订单数量
MAX_POSITION=1.0  # 最大仓位限制
DECREASE_POSITION=0.35  # 降低仓位触发点
ALER_POSITION=0.3  # 警告仓位限制
MARKET_ID=0  # 市场ID (对于Nado: 0=ETH-PERP, 1=BTC-PERP, 2=SOL-PERP 等)
ATR_THRESHOLD=7  # ATR波动阈值

# Exchange type selection (lighter, grvt, or nado)
EXCHANGE_TYPE=nado

# 钉钉通知配置（webhook 为空时关闭通知）
DINGTALK_WEBHOOK=''  # 完整的钉钉机器人 Webhook 地址，如 https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_KEYWORD=''  # 钉钉机器人安全设置中的关键词
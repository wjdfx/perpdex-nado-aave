# nado configuration
EXCHANGE_TYPE=nado

# Nado account (required)
# Nado uses private key for EIP712 signing (no API key required)
NADO_PRIVATE_KEY=''
NADO_ENV='mainnet'   # 'mainnet' or 'testnet'
NADO_SUBACCOUNT_NAME='default'

# Trading symbol (default is AAVEUSDT0)
NADO_SYMBOL='AAVEUSDT0'
# Optional: fixed product id (if empty, auto-resolve by NADO_SYMBOL)
NADO_PRODUCT_ID=''

# Optional: override endpoints (usually not needed)
# NADO_GATEWAY_REST='https://gateway.prod.nado.xyz/v1'
# NADO_GATEWAY_WS='wss://gateway.prod.nado.xyz/v1/ws'
# NADO_SUBSCRIPTIONS_WS='wss://gateway.prod.nado.xyz/v1/subscribe'
# NADO_ARCHIVE_URL='https://archive.prod.nado.xyz/v1'
# NADO_TRIGGER_URL='https://trigger.prod.nado.xyz/v1'

# Nado 网络时序与重试（可选，建议保留默认）
# NADO_RECV_TIME_OFFSET_MS: 下单 nonce 的 recv_time 预留毫秒（网络抖动大可调高，例如 1500~2500）
# NADO_CONTRACTS_QUERY_RETRY: 启动时 contracts 查询重试次数
# NADO_CONTRACTS_QUERY_RETRY_DELAY_MS: contracts 查询重试基础间隔毫秒（第N次会乘以N）
NADO_RECV_TIME_OFFSET_MS=1200
NADO_CONTRACTS_QUERY_RETRY=3
NADO_CONTRACTS_QUERY_RETRY_DELAY_MS=400

# Strategy direction and market
DIRECTION='LONG'
MARKET_ID=0

# Position and order caps
# MAX_TOTAL_ORDERS: 最大活跃订单数（开平仓合计）
# MAX_POSITION: 最大总持仓（单位=币）
# ALER_POSITION: 仓位预警阈值（达到后策略会更保守）
MAX_TOTAL_ORDERS=10
MAX_POSITION=1.0
ALER_POSITION=0.3

# 网格（刷量优先，允许密集成交）
# GRID_SPREAD: 单格价差百分比（0.05 = 0.05%）
# GRID_COUNT: 每侧网格层数
# GRID_AMOUNT: 每格下单数量（单位=币）
# CLOSE_ORDER_MAX_DISTANCE_PCT: 平仓单允许偏离当前价的最大百分比（防止异常补到远端）
GRID_SPREAD=0.16
GRID_COUNT=3
GRID_AMOUNT=1
CLOSE_ORDER_MAX_DISTANCE_PCT=1.2

# 主风控（放宽到能开单）
# ADVERSE_* 用于15m不利趋势检测：
# LONG: close<ema 且 adx强趋势 且 pdi<mdi 且 rsi低于阈值 -> 暂停开仓
ADVERSE_EMA_PERIOD=20
ADVERSE_RSI_PERIOD=14
ADVERSE_ADX_PERIOD=14
ADVERSE_ADX_THRESHOLD=28
ADVERSE_RSI_LONG_THRESHOLD=42
ADVERSE_RSI_SHORT_THRESHOLD=70

# 均值回归风控（放宽）
# EMA_REVERSION_THRESHOLD: 价格偏离EMA超过阈值时暂停（0.018=1.8%）
EMA_REVERSION_PERIOD=60
EMA_REVERSION_THRESHOLD=0.018

# 急变保护（保留）
# ATR_THRESHOLD: 控制动态网格间距放大触发（ATR超过该值时增大间距）
# RAPID_MOVE_THRESHOLD_PCT: 1m 急涨/急跌触发阈值（0.008=0.8%）
# RAPID_MOVE_ATR_PERIOD: 急变检测的 ATR 计算周期
# RAPID_MOVE_SOURCE_MAX_DIFF_PCT: Nado实时价与Binance K线收盘允许最大偏差（超出时回退K线价）
ATR_THRESHOLD=0.8
RAPID_MOVE_THRESHOLD_PCT=0.008
RAPID_MOVE_ATR_PERIOD=7
RAPID_MOVE_SOURCE_MAX_DIFF_PCT=0.2

# Logging
LOG_LEVEL='INFO'
LOG_FORMAT='%(asctime)s - %(filename)s:%(lineno)d - %(levelname)s - %(message)s'
LOG_DIR='./logs'

# Proxy (optional)
# PROXY_URL='http://127.0.0.1:7890'

# DingTalk notify (optional)
DINGTALK_WEBHOOK=''
DINGTALK_KEYWORD='Nado'

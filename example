# nado configuration
EXCHANGE_TYPE=nado

# nado account
NADO_PRIVATE_KEY=''
NADO_ENV=testnet
NADO_SUBACCOUNT_NAME=default

# optional: default symbol is AAVEUSDT0
NADO_SYMBOL=AAVEUSDT0
# optional: if set, use fixed product_id directly
NADO_PRODUCT_ID=

# grid configuration
DIRECTION=LONG
MARKET_ID=0
GRID_COUNT=3
GRID_AMOUNT=0.01
GRID_SPREAD=0.05
MAX_TOTAL_ORDERS=10
MAX_POSITION=1.0
ALER_POSITION=0.3
ATR_THRESHOLD=0.8
RAPID_MOVE_THRESHOLD_PCT=0.01
RAPID_MOVE_ATR_PERIOD=7
RAPID_MOVE_SOURCE_MAX_DIFF_PCT=0.2
ADVERSE_EMA_PERIOD=20
ADVERSE_RSI_PERIOD=14
ADVERSE_ADX_PERIOD=14
ADVERSE_ADX_THRESHOLD=25
ADVERSE_RSI_LONG_THRESHOLD=50
ADVERSE_RSI_SHORT_THRESHOLD=50
EMA_REVERSION_PERIOD=60
EMA_REVERSION_THRESHOLD=0.02

# logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(filename)s:%(lineno)d - %(levelname)s - %(message)s
LOG_DIR=./logs

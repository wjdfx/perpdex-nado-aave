# nado configuration
EXCHANGE_TYPE=nado

# nado account
NADO_PRIVATE_KEY=''
NADO_ENV=testnet
NADO_SUBACCOUNT_NAME=default

# optional: default symbol is AAVE-PERP
NADO_SYMBOL=AAVE-PERP
# optional: if set, use fixed product_id directly
NADO_PRODUCT_ID=

# grid configuration
DIRECTION=LONG
MARKET_ID=0
GRID_COUNT=3
GRID_AMOUNT=0.01
GRID_SPREAD=0.05
MAX_TOTAL_ORDERS=10
MAX_POSITION=1.0
ALER_POSITION=0.3
ATR_THRESHOLD=0.8
RAPID_MOVE_THRESHOLD_PCT=0.01

# logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(filename)s:%(lineno)d - %(levelname)s - %(message)s
LOG_DIR=./logs
